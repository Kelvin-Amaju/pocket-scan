<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar"><item name="colorPrimary">@color/pocket_green</item><item name="colorPrimaryDark">@color/pocket_green</item><item name="colorAccent">@color/pocket_green</item></style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar"><item name="windowActionBar">false</item><item name="windowNoTitle">true</item><item name="android:background">@null</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/pocket_surface</item><item name="android:navigationBarColor">@color/pocket_surface</item></style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen"><item name="android:background">@drawable/pocket_splash</item><item name="windowSplashScreenBackground">@color/pocket_surface</item><item name="windowSplashScreenAnimatedIcon">@drawable/pocket_mark</item><item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item></style>
</resources>
